{
  "name": "naga-sudoku",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "cap:sync": "npx cap sync android",
    "cap:build": "npm run build && npx cap sync android",
    "build:apk": "npm run cap:build && cd android && ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../naga-sudoku.apk",
    "build:c": "make -C naga-sudoku-c",
    "test:c": "make -C naga-sudoku-c test",
    "clean:c": "make -C naga-sudoku-c clean"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@google/genai": "^1.29.0",
    "@ionic/utils-terminal": "^2.3.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xmldom/xmldom": "^0.9.11",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sudoku-gen": "^1.0.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
